    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true"/>
      <outputTables sizeState="INTERMEDIATE" name="sales_output">
        <mapperTableEntries name="order_item_id" expression="row1.order_item_id " type="id_Integer"/>
        <mapperTableEntries name="order_id" expression="row2.order_id " type="id_Integer"/>
        <mapperTableEntries name="date_key" expression="row6.date_key " type="id_Integer"/>
        <mapperTableEntries name="customer_key" expression="row7.customer_key " type="id_Integer"/>
        <mapperTableEntries name="product_key" expression="row10.product_key" type="id_Integer"/>
        <mapperTableEntries name="store_key" expression="row8.store_key " type="id_Integer"/>
        <mapperTableEntries name="promotion_key" expression="row5.promotion_key != 0 ? row5.promotion_key : 1" type="id_Integer"/>
        <mapperTableEntries name="shipment_key" expression="row9.shipment_key " type="id_Integer"/>
        <mapperTableEntries name="quantity" expression="row1.qty " type="id_BigDecimal"/>
        <mapperTableEntries name="unit_price" expression="row1.price" type="id_BigDecimal"/>
        <mapperTableEntries name="cost_price" expression="row10.cost_price" type="id_BigDecimal"/>
        <mapperTableEntries name="gross_amount" expression="row1.price.multiply(row1.qty)" type="id_BigDecimal"/>
        <mapperTableEntries name="discount_amount" expression="row5.discount_pct != null ?&#xA;row1.price.multiply(row1.qty)&#xA;    .multiply(row5.discount_pct)&#xA;    .divide(new java.math.BigDecimal(100))&#xA;: new java.math.BigDecimal(&quot;0.00&quot;)" type="id_BigDecimal"/>
        <mapperTableEntries name="net_amount" expression="row5.discount_pct != null ? row1.price.multiply(row1.qty).subtract(row1.price.multiply(row1.qty).multiply(row5.discount_pct).divide(new java.math.BigDecimal(100))) : row1.price.multiply(row1.qty)" type="id_BigDecimal"/>
